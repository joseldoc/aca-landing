# Copy this file to .env.prod on the VPS, fill in real values, and pass it
# to `docker run --env-file .env.prod` / `docker compose`. NEVER commit the
# filled-in .env.prod to git — it holds real secrets. (.gitignore already
# excludes it.)

APP_ENV=prod
APP_DEBUG=0

# Generate with: openssl rand -hex 16
APP_SECRET=

# Leave as null://null until real SMTP credentials exist (see the mailer
# TODO in src/Controller/HomeController.php) — that keeps contact-form
# submissions working without silently failing, just with no real email
# sent yet. Swap in a real DSN (Brevo, Mailjet, etc.) when ready, e.g.:
# MAILER_DSN=smtp://USERNAME:PASSWORD@smtp.brevo.com:587
MAILER_DSN=null://null

# One or more SSH public keys (the *.pub file contents) allowed to SFTP in
# and drop files under public/uploads/ — e.g. real photos to replace the
# Unsplash placeholders. Separate multiple keys with "|".
# Example: ssh-ed25519 AAAA... someone@laptop|ssh-ed25519 AAAA... other@laptop
SFTP_AUTHORIZED_KEYS=
