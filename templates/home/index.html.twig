{% extends 'base.html.twig' %}

{% block body %}
<div class="acan" data-cursor data-hide-header data-to-top data-intro="{{ asset('assets/logo-inverse.svg') }}" style="font-family:var(--font-body);color:var(--ink-700);background:#fff">
    <div class="aca-progress" data-progress></div>

    <div style="background:var(--marine-900);color:var(--marine-200)">
        <div class="aca-container" style="height:40px;display:flex;align-items:center;gap:24px;font-size:12px;letter-spacing:.02em">
            <span style="white-space:nowrap">Siège social Lyon — bureaux Paris</span>
            <span class="util-mid" style="color:var(--marine-600)">•</span>
            <span class="util-mid">Interventions tôt le matin, le soir et le week-end</span>
            <a class="util-mid" href="mailto:acanettoyage.243@gmail.com" style="margin-left:auto;color:var(--marine-200)">acanettoyage.243@<wbr>gmail.com</a>
            <span class="util-mid" style="color:var(--marine-600)">|</span>
            <a href="tel:+33644959630" style="margin-left:auto;color:#fff;font-family:var(--font-mono);white-space:nowrap">+33 6 44 95 96 30</a>
        </div>
    </div>

    <header data-sticky-header style="position:sticky;top:0;z-index:30;background:rgba(255,255,255,.93);backdrop-filter:blur(10px);border-bottom:1px solid var(--ink-200)">
        <div class="aca-header-inner aca-container" style="display:flex;align-items:center;gap:36px">
            <a href="#accueil" style="display:flex;align-items:center;border-bottom:0"><img src="{{ asset('assets/logo.svg') }}" alt="ACA Nettoyage" style="display:block;height:42px;width:auto"></a>
            <nav class="aca-nav" aria-label="Navigation principale" style="display:flex;gap:22px;margin-left:8px;font-size:15px;font-weight:600;white-space:nowrap;min-width:0">
                <a class="nav-l aca-nav-link" href="#prestations" style="color:var(--ink-600)">Prestations</a>
                <a class="nav-l aca-nav-link" href="#secteurs" style="color:var(--ink-600)">Secteurs</a>
                <a class="nav-l aca-nav-link" href="#engagements" style="color:var(--ink-600)">Engagements</a>
                <a class="nav-l aca-nav-link" href="#tarifs" style="color:var(--ink-600)">Tarification</a>
                <a class="nav-l aca-nav-link" href="#contact" style="color:var(--ink-600)">Contact</a>
            </nav>
            <div style="margin-left:auto;display:flex;align-items:center;gap:12px">
                <a href="#contact" class="aca-btn aca-btn--primary aca-header-cta">Devis gratuit</a>
                <button type="button" class="aca-menu-btn" data-menu-toggle aria-expanded="false" aria-controls="aca-mnav" aria-label="Ouvrir le menu"><i data-lucide="menu" width="22" height="22" aria-hidden="true"></i></button>
            </div>
        </div>
    </header>

    {# Hors du <header> : son backdrop-filter piégerait un enfant position:fixed. #}
    <div id="aca-mnav" class="aca-mnav" role="dialog" aria-modal="true" aria-label="Menu" hidden>
        <div class="aca-mnav__top">
            <img src="{{ asset('assets/logo-inverse.svg') }}" alt="ACA Nettoyage" style="display:block;height:38px;width:auto">
            <button type="button" class="aca-mnav__close" data-menu-close aria-label="Fermer le menu"><i data-lucide="x" width="22" height="22" aria-hidden="true"></i></button>
        </div>
        <nav aria-label="Navigation mobile" class="aca-mnav__links">
            {% for link in [{href: '#prestations', label: 'Prestations'}, {href: '#secteurs', label: 'Secteurs'}, {href: '#engagements', label: 'Engagements'}, {href: '#tarifs', label: 'Tarification'}, {href: '#contact', label: 'Contact'}] %}
            <a href="{{ link.href }}">{{ link.label }}<i data-lucide="arrow-right" width="20" height="20" aria-hidden="true"></i></a>
            {% endfor %}
        </nav>
        <div class="aca-mnav__cta">
            <a href="#contact" class="aca-btn aca-btn--accent aca-btn--lg aca-btn--block">Demander un devis gratuit</a>
            <a href="https://wa.me/33644959630" class="aca-btn aca-btn--whatsapp aca-btn--lg aca-btn--block">Écrire sur WhatsApp</a>
            <a href="tel:+33644959630" class="aca-mnav__tel">+33 6 44 95 96 30</a>
        </div>
    </div>

    <main id="contenu" tabindex="-1">

    <section id="accueil" style="background:var(--marine-900);position:relative;overflow:hidden">
        <span class="aca-ghost aca-ghost--light" data-parallax="0.3" aria-hidden="true" style="font-size:clamp(160px,20vw,300px);left:-30px;bottom:-68px">propreté</span>
        <div style="position:absolute;inset:0;background:var(--pattern-stripe-dark)"></div>
        <div style="position:absolute;top:-120px;right:-80px;width:520px;height:520px;border-radius:999px;background:radial-gradient(closest-side,rgba(34,184,198,.18),transparent);animation:aca-glow 7s var(--ease-in-out) infinite"></div>
        <div class="aca-hero-grid" style="position:relative;max-width:1200px;margin:0 auto;padding:clamp(40px,5vw,104px) 40px clamp(56px,7vw,128px)">
            <div style="display:flex;flex-direction:column;gap:26px">
                <div class="aca-enter aca-enter-1 aca-eyebrow-row"><span class="aca-rule aca-rule-grow"></span><span class="aca-eyebrow aca-eyebrow--inverse">Nettoyage &amp; propreté professionnelle</span></div>
                <h1 data-split data-reveal style="font-family:var(--font-display);font-size:clamp(40px,5.4vw,72px);line-height:1;letter-spacing:-.03em;font-weight:800;color:#fff;margin:0;max-width:640px">Des locaux propres, sains et agréables.</h1>
                <p class="aca-enter aca-enter-3" style="font-size:20px;line-height:1.55;color:var(--marine-200);max-width:520px;margin:0">Bureaux, restaurants, véhicules, immeubles et logements : ACA Nettoyage intervient depuis Lyon, avec des bureaux à Paris. Un service fiable, flexible et adapté à vos besoins.</p>
                <div class="aca-enter aca-enter-4" style="display:flex;gap:12px;flex-wrap:wrap;margin-top:6px">
                    <a href="#contact" class="aca-btn aca-btn--accent aca-btn--lg" data-magnetic="7">Demander un devis gratuit</a>
                    <a href="https://wa.me/33644959630" class="aca-btn aca-btn--whatsapp aca-btn--lg" data-magnetic="7">Écrire sur WhatsApp</a>
                </div>
                <div class="aca-enter aca-enter-5" style="display:flex;gap:26px;flex-wrap:wrap;margin-top:10px;font-size:13px;color:var(--marine-200)">
                    <span style="display:flex;align-items:center;gap:8px"><i data-lucide="clock" width="16" height="16" style="color:var(--aqua-400)"></i>Devis sous 24 h</span>
                    <span style="display:flex;align-items:center;gap:8px"><i data-lucide="shield-check" width="16" height="16" style="color:var(--aqua-400)"></i>RC professionnelle</span>
                    <span style="display:flex;align-items:center;gap:8px"><i data-lucide="map-pin" width="16" height="16" style="color:var(--aqua-400)"></i>Lyon &amp; Paris</span>
                </div>
            </div>
            <div class="aca-enter-right aca-hero-figure" style="position:relative" data-parallax="0.1">
                <div data-tilt="4" class="aca-media-reveal--load aca-hero-media" style="position:relative;width:100%;min-width:0;height:420px;border-radius:14px;overflow:hidden;background:var(--marine-100)">
                    <div class="aca-photo">
                        <img fetchpriority="high" src="https://images.unsplash.com/photo-1504297050568-910d24c426d3?auto=format&fit=crop&w=1800&q=70" alt="Couloir vitré d'immeuble tertiaire, hors horaires">
                        <a class="aca-photo__credit" href="https://unsplash.com/@miabaker" target="_blank" rel="noopener">Photo par Mia Baker sur Unsplash</a>
                    </div>
                </div>
                <div class="aca-float aca-lift aca-hero-float" data-parallax="0.22" style="position:absolute;right:-30px;top:-32px;width:250px;background:#fff;border-radius:12px;box-shadow:var(--shadow-3);padding:20px 22px;display:flex;flex-direction:column;gap:10px;z-index:2">
                    <span class="aca-eyebrow">Visite technique</span>
                    <span style="font-family:var(--font-display);font-size:34px;font-weight:800;letter-spacing:-.02em;color:var(--marine-800);line-height:1">Gratuite</span>
                    <span style="font-size:13px;color:var(--ink-500);line-height:1.45">Nous évaluons vos locaux sur place avant tout chiffrage.</span>
                </div>
            </div>
        </div>
        <div style="height:4px;background:linear-gradient(to right,var(--aqua-500),var(--marine-600))"></div>
    </section>

    <div style="background:var(--marine-800);border-top:1px solid rgba(255,255,255,.08);border-bottom:1px solid rgba(255,255,255,.08);padding:18px 0">
        <div data-marquee="34" style="display:flex;overflow:hidden;width:100%">
            <div style="display:flex;align-items:center;gap:32px;padding-right:32px">
                {% for label in ['Bureaux et sièges', 'Véhicules et flottes', 'Restaurants et cuisines', 'Maisons et particuliers', 'Immeubles et parties communes', 'Magasins et commerces', 'Cabinets médicaux', 'Fin de chantier'] %}
                <span style="display:inline-flex;align-items:center;gap:32px;white-space:nowrap;font-size:15px;font-weight:600;color:var(--marine-200)">{{ label }}<span style="width:5px;height:5px;border-radius:99px;background:var(--aqua-500);flex:0 0 auto"></span></span>
                {% endfor %}
            </div>
        </div>
    </div>

    <section style="position:relative;background:var(--ink-900)">
        <div data-wipe-track class="aca-wipe-track">
            <div style="position:sticky;top:0;height:100vh;min-height:520px;overflow:hidden;display:flex;align-items:center">
                <div style="position:absolute;inset:0">
                    <div style="position:absolute;inset:0;filter:grayscale(1) brightness(.42);transform:scale(1.03)"><img loading="lazy" decoding="async" src="https://images.unsplash.com/photo-1549637642-90187f64f420?auto=format&fit=crop&w=1900&q=70" alt="" style="width:100%;height:100%;object-fit:cover"></div>
                    <div data-wipe style="position:absolute;inset:0"><img loading="lazy" decoding="async" src="https://images.unsplash.com/photo-1549637642-90187f64f420?auto=format&fit=crop&w=1900&q=70" alt="Plateau de bureaux nettoyé" style="width:100%;height:100%;object-fit:cover"></div>
                    <div style="position:absolute;inset:0;background:linear-gradient(90deg,rgba(7,34,42,.92) 0%,rgba(7,34,42,.62) 46%,rgba(7,34,42,.24) 100%)"></div>
                </div>
                <div class="aca-container" style="position:relative;width:100%">
                    <div style="max-width:560px;display:flex;flex-direction:column;gap:20px">
                        <div class="aca-eyebrow-row"><span style="font-family:var(--font-mono);font-size:12px;font-weight:700;color:var(--aqua-400)">01</span><span class="aca-rule"></span><span class="aca-eyebrow aca-eyebrow--inverse">Avant / après</span></div>
                        <h2 data-split data-reveal class="aca-h2 aca-h2--xl aca-h2--inverse">Le même plateau, une heure plus tard.</h2>
                        <p style="font-size:18px;line-height:1.6;color:var(--marine-200);margin:0;max-width:470px">Nous intervenons hors de vos horaires : vos équipes arrivent dans des locaux nets, sans jamais croiser un chariot ni une autolaveuse.</p>
                        <div style="display:flex;flex-wrap:wrap;gap:12px">
                            {% for tag in ['Sols traités', 'Surfaces de contact désinfectées', 'Sanitaires réapprovisionnés', 'Corbeilles vidées'] %}
                            <span style="display:inline-flex;align-items:center;gap:8px;padding:8px 14px;border-radius:999px;border:1px solid rgba(255,255,255,.22);color:#fff;font-size:13px;font-weight:600">{{ tag }}</span>
                            {% endfor %}
                        </div>
                        <span style="font-size:12px;color:rgba(255,255,255,.5);margin-top:4px">Faites défiler — la raclette révèle le résultat.</span>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section style="background:#fff">
        <div class="aca-container">
            <div data-reveal-stagger class="aca-stats-grid">
                {% for stat in [{value: '24 h', label: 'Devis détaillé après visite des lieux'}, {value: '2', label: 'Implantations : Lyon et Paris'}, {value: '6', label: 'Familles de prestations couvertes'}, {value: '1', label: 'Référent unique pour le suivi'}] %}
                <div>
                    <div class="aca-stat"><span class="aca-stat__value">{{ stat.value }}</span><span class="aca-stat__label">{{ stat.label }}</span></div>
                </div>
                {% endfor %}
            </div>
        </div>
    </section>

    <section style="padding:120px 0;background:#fff">
        <div class="aca-container" style="max-width:1100px;display:flex;flex-direction:column;gap:32px">
            <div data-reveal class="aca-eyebrow-row"><span class="aca-rule"></span><span class="aca-eyebrow">Notre mission</span></div>
            <p data-scrub style="font-family:var(--font-display);font-size:clamp(30px,3.7vw,54px);line-height:1.14;letter-spacing:-.026em;font-weight:700;color:var(--ink-900);margin:0;text-wrap:pretty">Garantir un environnement propre, sain et agréable, avec un service fiable, flexible et adapté à vos besoins spécifiques.</p>
        </div>
    </section>

    <section aria-label="Propre, sain, agréable, fiable, flexible" style="background:var(--marine-900);padding:72px 0;overflow:hidden">
        <div data-velocity class="aca-velocity" style="display:flex;flex-direction:column;gap:10px">
            {% set velocityWords = ['Propre', 'Sain', 'Agréable', 'Fiable', 'Flexible'] %}
            {% for dir in ['left', 'right'] %}
            <div data-marquee="42" data-marquee-dir="{{ dir }}" style="display:flex;overflow:hidden;width:100%">
                <div style="display:flex;align-items:center;gap:44px;padding-right:44px">
                    <span style="display:inline-flex;align-items:center;gap:44px;white-space:nowrap">
                        {% for word in velocityWords %}
                        {% set isOutline = (dir == 'left') == (loop.index0 is odd) %}
                        <span style="display:inline-flex;align-items:center;gap:44px;white-space:nowrap">
                            <span{% if isOutline %} class="aca-outline"{% endif %} style="font-family:var(--font-display);font-size:clamp(64px,9vw,136px);font-weight:800;letter-spacing:-.035em;line-height:1.02;{% if isOutline %}color:transparent{% else %}color:#fff{% endif %}">{{ word }}</span>
                            <span style="width:14px;height:14px;border-radius:99px;background:var(--aqua-500);flex:0 0 auto"></span>
                        </span>
                        {% endfor %}
                    </span>
                </div>
            </div>
            {% endfor %}
        </div>
    </section>

    <section id="prestations" style="padding:104px 0 96px;position:relative;overflow:hidden">
        <span class="aca-ghost" data-parallax="0.22" aria-hidden="true" style="font-size:clamp(120px,14vw,210px);right:-40px;top:-46px">domaines</span>
        <div class="aca-container">
            <div data-reveal style="display:flex;align-items:flex-end;justify-content:space-between;gap:40px;flex-wrap:wrap">
                <div style="max-width:640px">
                    <span class="aca-eyebrow">Nos domaines d'intervention</span>
                    <h2 data-split data-reveal class="aca-h2" style="margin:14px 0 0">Du véhicule au restaurant, du bureau à la maison</h2>
                </div>
                <p style="font-size:16px;line-height:1.6;color:var(--ink-500);max-width:360px;margin:0">Interventions quotidiennes, hebdomadaires ou sur mesure. Chaque prestation est contractualisée après visite technique.</p>
            </div>

            <div data-reveal-stagger class="aca-domaines-grid" style="margin-top:52px">
                <div class="aca-card aca-lift" style="display:flex;flex-direction:column;overflow:hidden">
                    <div style="height:220px;border-bottom:1px solid var(--ink-200)">
                        <div class="aca-photo">
                            <img loading="lazy" decoding="async" src="https://images.unsplash.com/photo-1740657254989-42fe9c3b8cce?auto=format&fit=crop&w=1400&q=70" alt="Agent en intervention — entretien des sols">
                            <a class="aca-photo__credit" href="https://unsplash.com/@purocleanoffortworth" target="_blank" rel="noopener">Photo par PuroClean of Fort Worth sur Unsplash</a>
                        </div>
                    </div>
                    <div style="padding:32px;display:flex;flex-direction:column;gap:18px">
                        <div style="display:flex;align-items:center;gap:14px">
                            <span style="display:flex;align-items:center;justify-content:center;width:48px;height:48px;border-radius:6px;background:var(--marine-100);color:var(--marine-700)"><i data-lucide="building-2" width="24" height="24"></i></span>
                            <div><h3 style="font-family:var(--font-display);font-size:26px;font-weight:700;color:var(--ink-900);margin:0">Entretien de bureaux</h3><span style="font-size:14px;color:var(--ink-500)">La prestation la plus demandée</span></div>
                        </div>
                        <p style="font-size:16px;line-height:1.6;color:var(--ink-600);margin:0;max-width:540px">Nettoyage quotidien ou périodique de vos espaces de travail, avant l'arrivée ou après le départ de vos équipes.</p>
                        <ul class="aca-checklist aca-checklist--two" style="margin:0;padding:0;list-style:none">
                            {% for item in ['Vidage des corbeilles', 'Dépoussiérage complet', 'Désinfection des surfaces de contact', 'Balayage, lavage, aspiration des sols', 'Entretien des sanitaires', 'Réapprovisionnement des consommables'] %}
                            <li class="aca-check"><span class="aca-check__mark"><i data-lucide="check" width="16" height="16"></i></span>{{ item }}</li>
                            {% endfor %}
                        </ul>
                    </div>
                </div>

                <div class="aca-domaines-sub">
                    <div class="aca-service aca-service--accent aca-lift">
                        <span class="aca-service__icon"><i data-lucide="car" width="24" height="24"></i></span>
                        <h3 class="aca-service__title">Nettoyage de véhicule</h3>
                        <p class="aca-service__desc">Voitures, utilitaires et flottes, sur votre parking.</p>
                        <ul class="aca-service__list">
                            {% for item in ['Aspiration intérieure, coffre inclus', 'Shampoing des sièges et moquettes', "Désinfection de l'habitacle", 'Lavage extérieur sans dégradation'] %}
                            <li class="aca-check"><span class="aca-check__mark"><i data-lucide="check" width="14" height="14"></i></span>{{ item }}</li>
                            {% endfor %}
                        </ul>
                    </div>
                    <div class="aca-service aca-lift">
                        <span class="aca-service__icon"><i data-lucide="utensils" width="24" height="24"></i></span>
                        <h3 class="aca-service__title">Restaurants et cuisines</h3>
                        <p class="aca-service__desc">Salle, office et cuisine, après le service.</p>
                        <ul class="aca-service__list">
                            {% for item in ['Dégraissage des plans et des sols', 'Désinfection des surfaces de contact', 'Sanitaires clients et vestiaires', 'Intervention de nuit ou tôt le matin'] %}
                            <li class="aca-check"><span class="aca-check__mark"><i data-lucide="check" width="14" height="14"></i></span>{{ item }}</li>
                            {% endfor %}
                        </ul>
                    </div>
                </div>
            </div>

            <div data-reveal-stagger class="aca-domaines-row3" style="margin-top:20px">
                <div class="aca-service aca-lift">
                    <span class="aca-service__icon"><i data-lucide="house" width="24" height="24"></i></span>
                    <h3 class="aca-service__title">Maisons et particuliers</h3>
                    <p class="aca-service__desc">Entretien régulier ou ponctuel du domicile.</p>
                    <ul class="aca-service__list">
                        {% for item in ['Entretien courant des pièces de vie', 'Vitres, balcons, terrasses', 'Remise en état avant / après déménagement'] %}
                        <li class="aca-check"><span class="aca-check__mark"><i data-lucide="check" width="14" height="14"></i></span>{{ item }}</li>
                        {% endfor %}
                    </ul>
                </div>
                <div class="aca-service aca-lift">
                    <span class="aca-service__icon"><i data-lucide="building" width="24" height="24"></i></span>
                    <h3 class="aca-service__title">Immeubles et parties communes</h3>
                    <p class="aca-service__desc">Halls, cages d'escalier, ascenseurs, containers.</p>
                    <ul class="aca-service__list">
                        {% for item in ['Rampes, poignées et boîtes aux lettres', 'Sols lino, carrelage, béton', 'Sortie et rentrée des containers'] %}
                        <li class="aca-check"><span class="aca-check__mark"><i data-lucide="check" width="14" height="14"></i></span>{{ item }}</li>
                        {% endfor %}
                    </ul>
                </div>
                <div class="aca-service aca-service--accent aca-lift">
                    <span class="aca-service__icon"><i data-lucide="sparkles" width="24" height="24"></i></span>
                    <h3 class="aca-service__title">Prestations spécialisées</h3>
                    <p class="aca-service__desc">Vitrerie en hauteur, moquettes, fin de chantier.</p>
                    <ul class="aca-service__list">
                        {% for item in ['Vitres en hauteur', 'Shampoing moquettes et fauteuils', 'Décapage et remise en cire des sols'] %}
                        <li class="aca-check"><span class="aca-check__mark"><i data-lucide="check" width="14" height="14"></i></span>{{ item }}</li>
                        {% endfor %}
                    </ul>
                </div>
            </div>
        </div>
    </section>

    <section id="secteurs" style="padding:88px 0;background:var(--ink-050);border-top:1px solid var(--ink-200);border-bottom:1px solid var(--ink-200)">
        <div class="aca-container">
            <div style="display:flex;align-items:baseline;gap:20px;flex-wrap:wrap">
                <h2 data-split data-reveal class="aca-h2 aca-h2--xs">Ce que nous nettoyons</h2>
                <span style="font-size:15px;color:var(--ink-500)">Protocoles et horaires adaptés à chaque activité.</span>
            </div>
            <div data-reveal-stagger class="aca-secteurs-grid" style="margin-top:36px">
                {% for sector in [{icon: 'building-2', label: 'Bureaux et sièges'}, {icon: 'house', label: 'Maisons et particuliers'}, {icon: 'store', label: 'Magasins et commerces'}, {icon: 'car', label: 'Véhicules et flottes'}, {icon: 'utensils', label: 'Restaurants et cuisines'}, {icon: 'building', label: 'Immeubles et résidences'}] %}
                <div class="aca-tile" style="background:#fff;border:1px solid var(--ink-200);border-radius:10px;padding:20px 16px;display:flex;flex-direction:column;gap:12px">
                    <i data-lucide="{{ sector.icon }}" width="22" height="22" style="color:var(--marine-600)"></i>
                    <span style="font-size:14px;font-weight:600;color:var(--ink-800);line-height:1.35">{{ sector.label }}</span>
                </div>
                {% endfor %}
            </div>
        </div>
    </section>

    <section style="padding:96px 0">
        <div class="aca-container">
            <div data-reveal style="display:flex;align-items:flex-end;justify-content:space-between;gap:40px;flex-wrap:wrap">
                <div style="max-width:620px">
                    <div class="aca-eyebrow-row"><span class="aca-rule"></span><span class="aca-eyebrow">Nos interventions en images</span></div>
                    <h2 data-split data-reveal class="aca-h2 aca-h2--md" style="margin:14px 0 0">Véhicule, bureau, restaurant, domicile</h2>
                </div>
