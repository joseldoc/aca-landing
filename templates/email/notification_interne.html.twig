<!DOCTYPE html>
<html lang="fr" xmlns="http://www.w3.org/1999/xhtml">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="color-scheme" content="light dark">
<meta name="supported-color-schemes" content="light dark">
<title>Nouvelle demande — {{ type_nettoyage }} — {{ ville }}</title>
<!--[if mso]><style>table,td{font-family:Arial,Helvetica,sans-serif!important}</style><![endif]-->
<style>
@media (max-width:620px){.aca-w{width:100%!important}.aca-px{padding-left:24px!important;padding-right:24px!important}.aca-stack{display:block!important;width:100%!important;padding:0 0 10px 0!important}}
@media (prefers-color-scheme:dark){.aca-body{background:#0E2E38!important}.aca-card{background:#123843!important}.aca-ink{color:#EDF3F4!important}.aca-muted{color:#BACDD1!important}}
</style>
</head>
<body class="aca-body" style="margin:0;padding:0;background:#EDF3F4;-webkit-text-size-adjust:100%">
<span style="display:none!important;visibility:hidden;opacity:0;color:transparent;height:0;width:0;overflow:hidden;mso-hide:all;font-size:1px;line-height:1px">{{ prenom }} {{ nom }} · {{ ville }} · réponse souhaitée par {{ canal }} — à rappeler sous 24 h.&#8199;&#847;&#8199;&#847;&#8199;&#847;</span>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" class="aca-body" style="background:#EDF3F4">
<tr><td align="center" style="padding:32px 12px">
<table role="presentation" width="600" cellpadding="0" cellspacing="0" border="0" class="aca-w" style="width:600px;max-width:600px">

<tr><td bgcolor="#22B8C6" style="background:#22B8C6;height:5px;border-radius:14px 14px 0 0;font-size:0;line-height:0">&nbsp;</td></tr>
<tr><td bgcolor="#062B34" class="aca-px" style="background:#062B34;padding:28px 40px 30px">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"><tr>
<td style="font-family:Arial,Helvetica,sans-serif;font-size:12px;line-height:16px;font-weight:700;letter-spacing:2px;text-transform:uppercase;color:#4ECDD8">Nouvelle demande · site web</td>
<td align="right" style="font-family:Arial,Helvetica,sans-serif;font-size:12px;line-height:16px;color:#7FC2CF">{{ date_envoi }}</td>
</tr></table>
<div style="margin-top:14px;font-family:Arial,Helvetica,sans-serif;font-size:28px;line-height:34px;font-weight:800;letter-spacing:-0.6px;color:#FFFFFF;mso-line-height-rule:exactly">{{ type_nettoyage }} — {{ ville }}</div>
<div style="margin-top:6px;font-family:Arial,Helvetica,sans-serif;font-size:15px;line-height:22px;color:#BDE2E9">{{ prenom }} {{ nom }} · {{ entreprise }}</div>
<table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin-top:16px"><tr><td bgcolor="#0F4C5C" style="background:#0F4C5C;border-radius:99px;padding:6px 14px;font-family:Arial,Helvetica,sans-serif;font-size:12px;line-height:16px;font-weight:700;color:#FFFFFF">Répondre par {{ canal }} · avant {{ echeance_24h }}</td></tr></table>
</td></tr>

<tr><td class="aca-card aca-px" bgcolor="#FFFFFF" style="background:#FFFFFF;padding:28px 40px 8px">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"><tr>
<td class="aca-stack" width="33%" style="padding:0 5px 0 0"><table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"><tr><td align="center" bgcolor="#0F4C5C" style="background:#0F4C5C;border-radius:10px"><a href="https://wa.me/{{ telephone_intl }}" style="display:block;padding:13px 10px;font-family:Arial,Helvetica,sans-serif;font-size:14px;line-height:20px;font-weight:700;color:#FFFFFF;text-decoration:none">WhatsApp</a></td></tr></table></td>
<td class="aca-stack" width="34%" style="padding:0 5px"><table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"><tr><td align="center" style="border:2px solid #0F4C5C;border-radius:10px"><a href="mailto:{{ contact_email }}?subject=Votre%20demande%20de%20devis%20ACA%20Nettoyage" class="aca-ink" style="display:block;padding:11px 10px;font-family:Arial,Helvetica,sans-serif;font-size:14px;line-height:20px;font-weight:700;color:#0F4C5C;text-decoration:none">Répondre par mail</a></td></tr></table></td>
<td class="aca-stack" width="33%" style="padding:0 0 0 5px"><table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"><tr><td align="center" style="border:2px solid #0F4C5C;border-radius:10px"><a href="tel:{{ telephone }}" class="aca-ink" style="display:block;padding:11px 10px;font-family:Arial,Helvetica,sans-serif;font-size:14px;line-height:20px;font-weight:700;color:#0F4C5C;text-decoration:none">Appeler</a></td></tr></table></td>
</tr></table>
</td></tr>

<tr><td class="aca-card aca-px" bgcolor="#FFFFFF" style="background:#FFFFFF;padding:22px 40px 8px">
<div style="font-family:Arial,Helvetica,sans-serif;font-size:12px;line-height:16px;font-weight:700;letter-spacing:2px;text-transform:uppercase;color:#5F868F">Contact</div>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-top:8px;font-family:Arial,Helvetica,sans-serif;font-size:15px;line-height:22px;mso-line-height-rule:exactly">
<tr><td width="36%" class="aca-muted" style="padding:9px 0;border-bottom:1px solid #DCE7E9;color:#5F868F">Nom</td><td class="aca-ink" style="padding:9px 0;border-bottom:1px solid #DCE7E9;color:#07222A;font-weight:700">{{ prenom }} {{ nom }}</td></tr>
<tr><td class="aca-muted" style="padding:9px 0;border-bottom:1px solid #DCE7E9;color:#5F868F">Entreprise</td><td class="aca-ink" style="padding:9px 0;border-bottom:1px solid #DCE7E9;color:#07222A">{{ entreprise }}</td></tr>
<tr><td class="aca-muted" style="padding:9px 0;border-bottom:1px solid #DCE7E9;color:#5F868F">Téléphone</td><td style="padding:9px 0;border-bottom:1px solid #DCE7E9"><a href="tel:{{ telephone }}" style="color:#087F8B;text-decoration:none">{{ telephone }}</a></td></tr>
<tr><td class="aca-muted" style="padding:9px 0;border-bottom:1px solid #DCE7E9;color:#5F868F">E-mail</td><td style="padding:9px 0;border-bottom:1px solid #DCE7E9"><a href="mailto:{{ contact_email }}" style="color:#087F8B;text-decoration:none">{{ contact_email }}</a></td></tr>
<tr><td class="aca-muted" style="padding:9px 0;color:#5F868F">Réponse souhaitée</td><td class="aca-ink" style="padding:9px 0;color:#07222A">{{ canal }}</td></tr>
</table>
</td></tr>

<tr><td class="aca-card aca-px" bgcolor="#FFFFFF" style="background:#FFFFFF;padding:22px 40px 8px">
<div style="font-family:Arial,Helvetica,sans-serif;font-size:12px;line-height:16px;font-weight:700;letter-spacing:2px;text-transform:uppercase;color:#5F868F">Besoin</div>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-top:8px;font-family:Arial,Helvetica,sans-serif;font-size:15px;line-height:22px;mso-line-height-rule:exactly">
<tr><td width="36%" class="aca-muted" style="padding:9px 0;border-bottom:1px solid #DCE7E9;color:#5F868F">Type de nettoyage</td><td class="aca-ink" style="padding:9px 0;border-bottom:1px solid #DCE7E9;color:#07222A;font-weight:700">{{ type_nettoyage }}</td></tr>
<tr><td class="aca-muted" style="padding:9px 0;border-bottom:1px solid #DCE7E9;color:#5F868F">Ville</td><td class="aca-ink" style="padding:9px 0;border-bottom:1px solid #DCE7E9;color:#07222A">{{ ville }}</td></tr>
<tr><td class="aca-muted" style="padding:9px 0;border-bottom:1px solid #DCE7E9;color:#5F868F">Fréquence</td><td class="aca-ink" style="padding:9px 0;border-bottom:1px solid #DCE7E9;color:#07222A">{{ frequence }}</td></tr>
{% if precision %}<tr><td class="aca-muted" style="padding:9px 0;border-bottom:1px solid #DCE7E9;color:#5F868F">Précision</td><td class="aca-ink" style="padding:9px 0;border-bottom:1px solid #DCE7E9;color:#07222A">{{ precision }}</td></tr>{% endif %}
{% if quantite %}<tr><td class="aca-muted" style="padding:9px 0;border-bottom:1px solid #DCE7E9;color:#5F868F">Superficie / quantité</td><td class="aca-ink" style="padding:9px 0;border-bottom:1px solid #DCE7E9;color:#07222A">{{ quantite }}</td></tr>{% endif %}
{% if agence %}<tr><td class="aca-muted" style="padding:9px 0;border-bottom:1px solid #DCE7E9;color:#5F868F">Agence</td><td class="aca-ink" style="padding:9px 0;border-bottom:1px solid #DCE7E9;color:#07222A">{{ agence }}</td></tr>{% endif %}
{% if prestations %}<tr><td class="aca-muted" style="padding:9px 0;color:#5F868F">Prestations</td><td class="aca-ink" style="padding:9px 0;color:#07222A">{{ prestations }}</td></tr>{% endif %}
</table>
</td></tr>

<tr><td class="aca-card aca-px" bgcolor="#FFFFFF" style="background:#FFFFFF;padding:22px 40px 40px;border-radius:0 0 14px 14px">
<div style="font-family:Arial,Helvetica,sans-serif;font-size:12px;line-height:16px;font-weight:700;letter-spacing:2px;text-transform:uppercase;color:#5F868F">Message</div>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-top:10px"><tr>
<td width="3" bgcolor="#22B8C6" style="background:#22B8C6;font-size:0;line-height:0">&nbsp;</td>
<td class="aca-ink" style="padding:4px 0 4px 16px;font-family:Arial,Helvetica,sans-serif;font-size:15px;line-height:24px;color:#07222A;mso-line-height-rule:exactly">{{ message }}</td>
</tr></table>
</td></tr>

<tr><td class="aca-px" style="padding:22px 40px 8px;font-family:Arial,Helvetica,sans-serif;font-size:12px;line-height:18px;color:#5F868F;text-align:center">Envoyé automatiquement par le formulaire de contact du site ACA Nettoyage.<br>Engagement : réponse et devis sous 24 h.</td></tr>

</table>
</td></tr>
</table>
</body>
</html>
